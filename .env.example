# =============================================================================
# EMBLEMA NEXUS — Variables de Entorno
# Plataforma Integral de Gestión Empresarial
# =============================================================================
# Copiar este archivo como .env.local y completar con valores reales.
# NUNCA commitear .env.local al repositorio.
# =============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
# Solo en el servidor, nunca con prefijo NEXT_PUBLIC_. El modo de proveedor la necesita para aplicar sus respuestas.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# --- Aplicación ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Emblema Nexus"

# --- Nextcloud (solo en el servidor; sin estas variables las rutas de archivos responden 503) ---
NEXTCLOUD_URL=http://localhost:8080
NEXTCLOUD_USER=admin
NEXTCLOUD_APP_PASSWORD=tu-app-password-aqui

# --- DGII / e-CF (Fase 5) ---
# DGII_P12_BASE64=certificado-en-base64
# DGII_P12_SECRET=contraseña-del-certificado
# DGII_ENVIRONMENT=DEV

# --- Facturación por proveedor (MSeller) ---
# Clave de 32 bytes en base64 con la que el servidor cifra las credenciales del proveedor.
# Genérala con: openssl rand -base64 32. Si se pierde o cambia, hay que registrar las credenciales de nuevo.
BILLING_SECRETS_KEY=reemplaza-con-32-bytes-en-base64
# Solo desarrollo: URL del proveedor simulado (scripts/mseller-stub.mjs). Se ignora en producción.
# MSELLER_BASE_URL_OVERRIDE=http://127.0.0.1:4010

# --- Configuración Inicial ---
ADMIN_EMAIL=admin@emblemaNexus.local
ADMIN_PASSWORD=cambiar-en-produccion

# --- Zona Horaria ---
TZ=America/Santo_Domingo
