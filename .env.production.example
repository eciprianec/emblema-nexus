# =============================================================================
# EMBLEMA NEXUS — Variables de Entorno de Producción (.env.production)
# =============================================================================
# INSTRUCCIONES DE DESPLIEGUE:
# 1. Copie este archivo como '.env.production' en la raíz del servidor:
#      cp .env.production.example .env.production
# 2. Complete cada sección con las credenciales y dominios reales del entorno.
# 3. Restrinja los permisos del archivo para que solo el propietario pueda leerlo:
#      chmod 600 .env.production
# 4. NUNCA suba el archivo '.env.production' al control de versiones (Git).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. ENTORNO GENERAL Y ZONA HORARIA
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
# Desactiva la telemetría anónima de Next.js
NEXT_TELEMETRY_DISABLED=1
# Zona horaria oficial para República Dominicana (Cálculos de impuestos y vencimientos)
TZ=America/Santo_Domingo

# -----------------------------------------------------------------------------
# 2. DOMINIOS Y PROXY INVERSO (Caddy / Let's Encrypt / Nginx)
# -----------------------------------------------------------------------------
# Dominio principal para la plataforma web Emblema Nexus
APP_DOMAIN=app.emblemanexus.com
# Subdominio exclusivo para almacenamiento documental WebDAV (Nextcloud)
NEXTCLOUD_DOMAIN=cloud.emblemanexus.com
# Correo del administrador de sistemas para la emisión y renovación automática de certificados SSL
ACME_EMAIL=admin@emblemanexus.com

# -----------------------------------------------------------------------------
# 3. URLS PÚBLICAS DE LA APLICACIÓN
# -----------------------------------------------------------------------------
# URL completa accesible por usuarios y clientes para enlaces de correos y callbacks
NEXT_PUBLIC_APP_URL=https://app.emblemanexus.com
NEXT_PUBLIC_APP_NAME="Emblema Nexus"

# -----------------------------------------------------------------------------
# 4. MOTOR DE BASE DE DATOS (PostgreSQL 15)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=emblema_nexus
POSTGRES_USER=emblema_user
# Generar con: openssl rand -hex 20
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_POSTGRES_AQUI
# Base de datos secundaria dedicada para Nextcloud
NEXTCLOUD_DB=nextcloud

# -----------------------------------------------------------------------------
# 5. CACHÉ EN MEMORIA (Redis Alpine)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# Generar con: openssl rand -hex 20
REDIS_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_REDIS_AQUI

# -----------------------------------------------------------------------------
# 6. CAPA DE DATOS Y AUTENTICACIÓN (Supabase / Postgres / JWT)
# -----------------------------------------------------------------------------
# URL interna o externa de la API de Supabase / PostgREST
NEXT_PUBLIC_SUPABASE_URL=https://app.emblemanexus.com
# Clave pública anónima de Supabase para clientes web
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui
# Clave de superusuario con rol de servicio (bypasea RLS). SOLO uso en backend.
SUPABASE_SERVICE_ROLE_KEY=CAMBIAR_POR_SERVICE_ROLE_KEY_PRIVADA_AQUI
# Clave secreta para firma y verificación de tokens de sesión JWT
# Generar con: openssl rand -hex 32
JWT_SECRET=CAMBIAR_POR_JWT_SECRET_HEX_32_CARACTERES

# -----------------------------------------------------------------------------
# 7. GESTOR DOCUMENTAL WEBDAV (Nextcloud Apache)
# -----------------------------------------------------------------------------
# URL pública o interna de comunicación hacia Nextcloud
NEXTCLOUD_URL=https://cloud.emblemanexus.com
# Usuario administrador maestro para la instalación inicial
NEXTCLOUD_ADMIN_USER=admin
# Contraseña de instalación inicial de Nextcloud
NEXTCLOUD_ADMIN_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_NEXTCLOUD_AQUI
# Usuario del sistema que utiliza Emblema Nexus para subir/leer expedientes
NEXTCLOUD_USER=emblema_system
# Contraseña de aplicación (App Password generada en Nextcloud > Configuración > Seguridad)
NEXTCLOUD_APP_PASSWORD=CAMBIAR_POR_APP_PASSWORD_GENERADO_EN_NEXTCLOUD

# -----------------------------------------------------------------------------
# 8. FACTURACIÓN ELECTRÓNICA DGII (República Dominicana — e-CF)
# -----------------------------------------------------------------------------
# Entorno de operación DGII:
#   - CERT: Entorno de homologación, pruebas y certificación oficial DGII.
#   - PROD: Entorno productivo real con validez fiscal tributaria.
DGII_ENVIRONMENT=CERT
# RNC de la empresa emisora registrado en DGII
DGII_RNC_EMISOR=130862346
# Archivo de certificado digital (.p12 o .pfx) en base64 de una sola línea:
# En Linux: base64 -w 0 certificado.p12 > cert_base64.txt
# En Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("certificado.p12"))
DGII_P12_BASE64=MIIG...CERTIFICADO_DIGITAL_EN_UNA_SOLA_LINEA_BASE64...
# Contraseña de protección del certificado digital PKCS#12
DGII_P12_SECRET=CAMBIAR_POR_PASSWORD_DEL_CERTIFICADO_P12

# -----------------------------------------------------------------------------
# 9. SERVIDOR DE CORREO SALIENTE (SMTP — Notificaciones y Alertas)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
# true para puerto 465 (SSL), false para 587 (TLS/STARTTLS)
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=CAMBIAR_POR_API_KEY_O_PASSWORD_SMTP
SMTP_FROM=notificaciones@emblemanexus.com
SMTP_FROM_NAME="Emblema Nexus - Notificaciones"

# -----------------------------------------------------------------------------
# 10. ADMINISTRADOR INICIAL DE LA PLATAFORMA
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@emblemanexus.com
ADMIN_PASSWORD=CAMBIAR_POR_PASSWORD_ADMINISTRADOR_INICIAL
